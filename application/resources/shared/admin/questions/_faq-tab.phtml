<?php
if (!empty($this->items)) :
    foreach ($this->items as $item) :
?>
	<div class="panel panel-default">
		<div class="panel-heading"><?php echo $item['name']; ?></div>
		<div class="panel-body">
        <?php foreach ($item['questions'] as $question) : ?>
        	<div style="margin-bottom: 5px; font-weight: <?php echo $question['readed'] ? 'normal' : 'bold'; ?>;">
        		<i class="fa fa-arrow-right"></i>
			<?php if (!$question['readed']) : ?>
				<i class="fa fa-exclamation-triangle"></i>
			<?php endif; ?>
				<a href="<?php echo route_reset('admin', ['module' => ($this->module ?? 'programs'), 'controller' => ($this->controller ?? $item['targetController']), 'action' => 'edit', 'id' => $question['targetId'], 't' => time()]); ?>#_tab=faq.<?php echo $question['id']; ?>">
					<?php echo $question['text']; ?>
				</a>
				<br><small style="font-size: 0.9em;"><?php echo translate('от'); ?> <strong><?php echo $question['owner']; ?></strong></small>
			<?php if (!empty($question['toUser'])) : ?>
				 <small style="font-size: 0.9em;"><?php echo translate('до'); ?> <strong><?php echo implode(', ', $question['toUser']); ?></strong></small>
			<?php endif; ?>
			</div>
		<?php endforeach; ?>
		</div>
	</div>
<?php
    endforeach;
else :
?>
	<h3 style="margin: 0;"><?php echo translate('Няма отворени въпроси'); ?></h3>
<?php endif; ?>