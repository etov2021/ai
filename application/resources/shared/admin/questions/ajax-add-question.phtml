<form class="form-horizontal" action="<?php echo route(); ?>" method="post" enctype="multipart/form-data">
	<div class="row">
		<div class="col-md-12">
			<label class="form-label"><?php echo translate('Статус'); ?></label>
			<select name="status" class="form-control select2">
				<?php echo build_options($this->statuses, ($this->post['status'] ?? '')); ?>
			</select>
		</div>
