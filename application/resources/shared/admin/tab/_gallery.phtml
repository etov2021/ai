$(".tagsinput").on('itemAdded', function(event) {
	var data = {
			'target' : '<?php echo $this->item->getTarget(); ?>',
			'targetId' : '<?php echo $this->item->getTargetId(); ?>',
			'tags' : $(".tagsinput").tagsinput('items')
	}
	$.post('<?php echo route_reset('admin', ['module' => 'files', 'controller' => 'index', 'action' => 'add-tags']); ?>', data , function () {
      $('.fileTags').append($('<option>', {
          value: event.item,
          text : event.item
        }));
        $('.fileTags').trigger('change');
	});

});

$(".tagsinput").on('itemRemoved', function(event) {
	var data = {
			'target' : '<?php echo $this->item->getTarget(); ?>',
			'targetId' : '<?php echo $this->item->getTargetId(); ?>',
			'tags' : $(".tagsinput").tagsinput('items')
	}
	$.post('<?php echo route_reset('admin', ['module' => 'files', 'controller' => 'index', 'action' => 'add-tags']); ?>', data , function () {
		 $('.fileTags').find('[value="'+event.item+'"]').remove();
		 $('.fileTags').trigger('select2:unselect');
	});

});

function makeTableSortable_<?php echo $type; ?>()
{
    $("#<?php echo $type; ?>-ajaxGalleryFiles table tbody").sortable({
    	handle: '.handle',
    	axis: 'y',
    	placeholder: "ui-state-highlight",
        helper: function(e, ui) {
            ui.children().each(function() {
                $(this).width($(this).width());
            });
            return ui;
        },
        update: function (event, ui) {
        	if (this !== ui.item.parent()[0]) {
            	return;
        	}
            var data = $(this).sortable('serialize');
            ajaxMessage = '<?php echo translate('Файловете са подредени'); ?>';
            $.post('<?php echo route_reset('admin', ['module' => 'files', 'controller' => 'index', 'action' => 'reorder-files']); ?>', data, function () {}).error(function () {
				window.location.reload(true);
            });
        }
    });
}
