$('.dropzone').droppable();

$('.dropzone').bind('dragover drop', function(event) {

    event.stopPropagation();
    event.preventDefault();

    if (event.type == 'drop') {
		var acceptedFiles = [];
    	var link = event.originalEvent.dataTransfer.getData('Text');
    	if (link) {
    		acceptedFiles[0] = link;
    	} else {
        	var accept = $(this).find('input[type="file"]').attr('accept');
        	if (accept) {
        		accept = accept.split(',');
        		var files = event.originalEvent.dataTransfer.files;
                for (var i = 0; i < files.length; ++i) {
                	var name = files[i].name.toLowerCase();
                    var ext  = name.slice((name.lastIndexOf('.') - 1 >>> 0) + 1);
                    for (var j = 0, k = accept.length; j < k; ++j) {
                    	var type = $.trim(accept[j]);
                    	if (files[i].type == type
                        	|| (type.substring(0, 1) === '.' && type === ext)
                    	) {
                	    	acceptedFiles.push(files[i]);
                	    	break;
                	    }
                    }
                }
        	} else {
        		acceptedFiles = this.files;
        	}
        	if (acceptedFiles.length === 0) {
        		$(this).val('');
        	    return;
        	}
    	}

    	var form = $(this).closest('form');
    	var formData = new FormData();

    	for (var i = 0; i < acceptedFiles.length; ++i) {
    	    formData.append('<?php echo $type; ?>[]', acceptedFiles[i]);
    	}

		if($('.bootstrap-tagsinput span.active').length) {
			formData.append('tag', $('.bootstrap-tagsinput span.active').text());
		}

    	formData.append('type', '<?php echo $type; ?>');
    	formData.append('target', '<?php echo $this->item->getTarget(); ?>');
    	formData.append('targetId', '<?php echo $this->item->getTargetId(); ?>');
    	formData.append('settings', JSON.stringify(<?php echo json_encode($this->item->getFileSettings()); ?>));

    	if (acceptedFiles.length === 1) {
    		ajaxMessage = '<?php echo translate('Файлът е добавен'); ?>';
    	} else {
    		ajaxMessage = '<?php echo translate('Файловете са добавени'); ?>';
    	}

        $.ajax({
            url: '<?php echo route('admin', ['module' => 'files', 'controller' => 'index', 'action' => 'upload-files']); ?>',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                if (res) {
                    $('#<?php echo $type; ?>-ajaxGalleryFiles').html(res);
                    makeTableSortable_<?php echo $type; ?>();
                	updateTags();
                }
            },
            error: function (xhr) {
    			//alert(xhr.responseText);
            }
        });

        $(this).val('');

    }
});


$('#<?php echo $type; ?>-gallery').on('change', '[type="file"]', function () {


	var accept        = $(this).attr('accept');
	var acceptedFiles = [];

	if (accept) {
		accept = accept.split(',');
		var files = this.files;
        for (var i = 0; i < files.length; ++i) {
        	var name = files[i].name.toLowerCase();
            var ext  = name.slice((name.lastIndexOf('.') - 1 >>> 0) + 1);
            for (var j = 0, k = accept.length; j < k; ++j) {
            	var type = $.trim(accept[j]);
            	if (files[i].type == type
                	|| (type.substring(0, 1) === '.' && type === ext)
            	) {
        	    	acceptedFiles.push(files[i]);
        	    	break;
        	    }
            }
        }
	} else {
		acceptedFiles = this.files;
	}

	if (acceptedFiles.length === 0) {
		$(this).val('');
	    return;
	}

	var form = $(this).closest('form');

	var formData = new FormData();

	for (var i = 0; i < acceptedFiles.length; ++i) {
	    formData.append('<?php echo $type; ?>[]', acceptedFiles[i]);
	}

	if($('.bootstrap-tagsinput span.active').length) {
		formData.append('tag', $('.bootstrap-tagsinput span.active').text());
	}
	formData.append('type', '<?php echo $type; ?>');
	formData.append('target', '<?php echo $this->item->getTarget(); ?>');
	formData.append('targetId', '<?php echo $this->item->getTargetId(); ?>');
	formData.append('settings', JSON.stringify(<?php echo json_encode($this->item->getFileSettings()); ?>));

	if (acceptedFiles.length === 1) {
		ajaxMessage = '<?php echo translate('Файлът е добавен'); ?>';
	} else {
		ajaxMessage = '<?php echo translate('Файловете са добавени'); ?>';
	}
    $.ajax({
        url: '<?php echo route('admin', ['module' => 'files', 'controller' => 'index', 'action' => 'upload-files']); ?>',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function (res) {
            if (res) {
                $('#<?php echo $type; ?>-ajaxGalleryFiles').html(res);
                makeTableSortable_<?php echo $type; ?>();
              	updateTags();
            }
        },
        error: function (xhr) {
			//alert(xhr.responseText);
        }
    });

    $(this).val('');
});

var timeoutIds_<?php echo $type; ?> = {};

$('#<?php echo $type; ?>-gallery').on('input propertychange select2:select select2:unselect', '.metadata input, .metadata textarea, .metadata select', function () {
	var id   = $(this).attr('data-id');	//console.log($(this));
    var data = [
        {name: 'id', value: id},
        {name: 'fileLang', value: app.language.current.code}
    ];
	$(this).closest('.metadata').find('input, textarea, select').each(function () {
		var val = null
		if($(this).hasClass('select2')) {
			val = $(this).select2('val');
		} else {
			val = this.value;
		}
		data.push({name: $(this).attr('data-field'), value: val});
	});
	clearTimeout(timeoutIds_<?php echo $type; ?>[id]);
	timeoutIds_<?php echo $type; ?>[id] = setTimeout(function() {
		ajaxMessage = '<?php echo translate('Информацията е обновена'); ?>';
		$.post('<?php echo route_reset('admin', ['module' => 'files', 'controller' => 'index', 'action' => 'update-file']); ?>', data, function () {});
		updateTags();
	}, 500);
});

$('#<?php echo $type; ?>-gallery').on('click', '.updateFile', function () {

	var tr = $(this).closest('tr');
	var input = tr.find('input');
	var textarea = tr.find('textarea');

	var data = {
		id: $(this).attr('data-id'),
