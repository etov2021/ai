		fileLang: '<?php echo app('current_language')->getCode(); ?>'
	};

	ajaxMessage = '<?php echo translate('Информацията е обновена'); ?>';
	$.post('<?php echo route_reset('admin', ['module' => 'files', 'controller' => 'index', 'action' => 'update-file']); ?>', data, function () {

		updateTags();

	});

	return false;
});


