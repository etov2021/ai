function responsive_filemanager_callback_multiple_select_<?php echo $type; ?>(files)
{
	$('#<?php echo $type; ?>-openFileManagerDialog').dialog('close');

	var form = new FormData();

	for (var i = 0, n = files.length; i < n; ++i) {
		form.append('files[]', files[i]);
	}
	if($('.bootstrap-tagsinput span.active').length) {
		form.append('tag', $('.bootstrap-tagsinput span.active').text());
	}
	form.append('type', '<?php echo $type; ?>');
	form.append('target', '<?php echo $this->item->getTarget(); ?>');
	form.append('targetId', '<?php echo (int) $this->item->getTargetId(); ?>');
	form.append('settings', JSON.stringify(<?php echo json_encode($this->item->getFileSettings()); ?>));

	if (files.length === 1) {
		ajaxMessage = '<?php echo translate('Файлът е добавен'); ?>';
	} else {
		ajaxMessage = '<?php echo translate('Файловете са добавени'); ?>';
	}

    $.ajax({
		type: "POST",
		url: "<?php echo route_reset('admin', ['module' => 'files', 'controller' => 'index', 'action' => 'upload-files-from-public']); ?>",
		data: form,
		processData: false,
		contentType: false,
		success: function (res) {
            $('#<?php echo $type; ?>-ajaxGalleryFiles').html(res);
            makeTableSortable_<?php echo $type; ?>();
        	updateTags();
		},
        error: function (xhr) {
			//alert(xhr.responseText);
        }
	})
}

$('#<?php echo $type; ?>-gallery').on('click', '[data-handler="check-all"]', function () {
	var name = $(this).attr('data-rel');
	var checkboxes = $('#<?php echo $type; ?>-gallery input[type="checkbox"][name="' + name + '"]');
	if ($(this).is(':checked')) {
		checkboxes.prop('checked', true);
	} else {
		checkboxes.prop('checked', false);
	}
});

$('#<?php echo $type; ?>-gallery').on('click', '[data-handler="delete-selected"]', function () {
	var name = $(this).attr('data-rel');
	var ids  = $('#<?php echo $type; ?>-gallery input[type="checkbox"][name="' + name + '"]:checked');
	if (ids.length) {
		smart.confirm("Сигурни ли сте, че искате да изтриете избраните записи?", function (yes) {
			if (yes) {
				var data = [];
				ids.each(function () {
					data.push({name: "id[]", value: $(this).val()});
				});
				if (ids.length === 1) {
					ajaxMessage = 'Файлът е изтрит';
				} else {
					ajaxMessage = 'Файловете са изтрити';
				}
				$('#<?php echo $type; ?>-gallery [data-handler="check-all"]').prop('checked', false);
				$.post('<?php echo route_reset('admin', ['module' => 'files', 'controller' => 'index', 'action' => 'delete-file']); ?>', data, function () {
					ids.each(function () {
						$(this).closest('tr').remove();
					});
					makeTableSortable_<?php echo $type; ?>();
					updateTags();
				});
			}
		});
	} else {
		smart.alert("Моля, изберете файлове за изтриване");
	}
	return false;
});

