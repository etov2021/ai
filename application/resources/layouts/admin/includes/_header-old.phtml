<script>
$(function () {
	var params = {};
    window.location.hash.substring(1).split('&').map(hk => {
		let temp = hk.split('=');
		if (temp[0]) {
        	params[temp[0]] = temp[1];
		}
    });
    if (params._tab) {
    	var _getTab = params._tab.split('.');
    	if (_getTab[0]) {
    		$('li#' + _getTab[0] + ' a').trigger('click');
    		if (_getTab[1]) {
        		var el = $('tr[data-id="' + _getTab[1] + '"]');
        		if (el.length) {
        			el.effect('highlight', {}, 3000, function () {});
        		}
    		}
    		history.pushState("", document.title, window.location.pathname + window.location.search);
    		//window.location.hash = '';
    		//history.pushState('', '', '<?php echo route(null, ['_tab' => null]); ?>');
    	}
    }
});
$(document).on('click', '.faq .dropdown-menu', function (e) {
	e.stopPropagation();
});
$(function () {
	$('.faq-tabs ul li a').each(function () {
	    var current = $(this).attr('href');
	    var n = current.indexOf('#');
	    $(this).attr('href', window.location.href + current.substr(n));
	});
	$('.faq-tabs').tabs();
});
</script>
