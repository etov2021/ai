$(function () {

	$('div.ipp-ranger').after('<a class="btn btn-success" data-handler="export" style="margin-left: 5px;" data-href="<?php echo route('admin', ['action' => 'export']); ?>" href="<?php echo route('admin', ['action' => 'export']); ?>"><?php echo translate('Експорт'); ?></a>');

	$('[data-handler="export"]').on('click', function () {
		var inputs = $(this).parent().find('table tbody tr td input[type="checkbox"]:checked');
		var ids = [];
		inputs.each(function () {
			ids.push($(this).val());
		});
		var href = $(this).attr('data-href');
		if (ids.length) {
			href = href + (href.match(/export\?/) ? '&' : '?') + 'selectedIds=' + ids.join(',');
		}
		$(this).attr('href', href);
	});

});
