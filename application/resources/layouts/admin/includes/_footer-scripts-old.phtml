$(function () {
	var suspect = '<span class="fa fa-exclamation-circle" style="font-size: 2em; color: orange;"> </span> ';
	$('table tbody tr td [data-suspect="1"]').each(function () {
		var td = $(this).closest('td');
		if (td.length) {
    		td.prepend(suspect);
		}
	});
	$('div[data-suspect="1"]').each(function () {
		$(this).prepend(suspect);
	});
	// copy
	function copyToClipboard(str) {
        const el = document.createElement('textarea');
        el.value = str;
        el.setAttribute('readonly', '');
        el.style.position = 'absolute';
        el.style.left = '-9999px';
        document.body.appendChild(el);
        el.select();
        document.execCommand('copy');
        document.body.removeChild(el);
	}
	$('form.copyble input[type="text"]:not(.not-copyble), form.copyble textarea:not(.not-copyble)').each(function () {
		var p = $(this).parent();
		if (!$(this).closest('form').hasClass('copyble')) {
			return;
		}
		p.find('label').append(' <span data-handler="copy-text" data-value="' + $(this).val().replace(/<.*?>/g, '') + '" class="fa fa-copy" style="cursor: pointer;"></span>');
	});
	$('table.copyble tbody tr td:not(.not-copyble)').each(function () {
		//$(this).css('position', 'relative');
		var txt = $(this).text();
		if (!$(this).closest('table').hasClass('copyble')) {
			return;
		}
		if (txt) {
			$(this).append(' <span data-handler="copy-text" data-value="' + txt.replace(/<.*?>/g, '') + '" class="fa fa-copy" style="cursor: pointer;"></span>');
		}
	});
	$(document).on('click', '[data-handler="copy-text"]', function () {
		copyToClipboard($(this).attr('data-value'));
		return false;
	});
});
$(function () {
	var hasStorage = typeof(Storage) !== undefined;
	if (hasStorage) {
		var storage = window.sessionStorage;
		var storageData = {};
		var storageItem = storage.getItem('grid_row');
		if (storageItem === null) {
			storage.setItem('grid_row', JSON.stringify({}));
		}
		try {
			storageData = JSON.parse(storageItem);
			if (storageData && storageData.url === app.url.routeQSA) {
				/* var input = $('table.memory-row tbody tr td[data-source-field="id"] input[value="' + storageData.id + '"]');
				if (input.length) {
					var el = input.closest('tr');
					$([document.documentElement, document.body]).animate({ scrollTop: el.offset().top }, 0);
					el.effect('highlight', {}, 1000, function () {});
				} */
				$([document.documentElement, document.body]).animate({ scrollTop: storageData.scrollTop }, 0);
				storage.setItem('grid_row', JSON.stringify({}));
			}
		} catch (e) {
			//console.log(e);
		}
    	$('table.memory-row tbody a').on('click', function () {
        	var tr = $(this).closest('tr');
        	var id = tr.find('td[data-source-field="id"] input').val();
    		storageData.url = app.url.routeQSA;
        	storageData.index = tr.index();
        	storageData.id = id;
        	storageData.scrollTop = $(document).scrollTop();
			storage.setItem('grid_row', JSON.stringify(storageData));
    		//return false;
    	});
	}
});

