<script>
var reload = 0;
$('input[name="name"]').on('input', function () {
	var that = $(this);
	var icon = $(this).closest('.input-group').find('.glyphicon');
	var id = $(this).attr('data-id');
	var oldValue = $(this).attr('data-old-value');
	var value = $(this).val();
	if (reload) {
		window.clearTimeout(reload);
	}
	reload = window.setTimeout(function () {
		icon.removeClass('glyphicon-file').addClass('glyphicon-refresh');
		$.post('<?php echo route_reset('admin', ['module' => 'files', 'controller' => 'storage', 'action' => 'ajax-change-name']); ?>', {id: id, value: value}, function (name) {
			that.val(name);
			that.attr('data-old-value', name);
		}).fail(function () {
			that.val(oldValue);
		}).always(function () {
			icon.removeClass('glyphicon-refresh').addClass('glyphicon-file');
		});
	}, 500);
});
$('[data-handler="check-all"]').on('click', function () {
	var checkboxes = $('input[type="checkbox"][name="' + $(this).attr('data-rel') + '"]');
	if ($(this).is(':checked')) {
		checkboxes.prop('checked', true);
	} else {
		checkboxes.prop('checked', false);
	}
});
$('[data-handler="delete-selected"]').on('click', function () {
	var ids = $('input[type="checkbox"][name="' +$(this).attr('data-rel') + '"]:checked');
	if (ids.length) {
		smart.confirm("Сигурни ли сте, че искате да изтриете избраните записи?", function (yes) {
			if (yes) {
				var data = [];
				ids.each(function () {
					data.push({name: "id[]", value: $(this).val()});
				});
				$('[data-handler="check-all"]').prop('checked', false);
				ajaxMessage = ids.length === 1 ? 'Файлът е изтрит' : 'Файловете са изтрити';
				$.post('<?php echo route_reset('admin', ['module' => 'files', 'controller' => 'storage', 'action' => 'delete-file']); ?>', data, function () {
					ids.each(function () {
						$(this).closest('tr').remove();
					});
				});
			}
		});
	} else {
		smart.alert("Моля, изберете файлове за изтриване");
	}
	return false;
});

function uploadFiles(files, accept)
{
	var accept = $(this).find('input[type="file"]').attr('accept');
	var acceptedFiles = [];

	if (accept) {
		accept = accept.split(',');
        for (var i = 0; i < files.length; ++i) {
        	var name = files[i].name.toLowerCase();
            var ext  = name.slice((name.lastIndexOf('.') - 1 >>> 0) + 1);
            for (var j = 0, k = accept.length; j < k; ++j) {
            	var type = $.trim(accept[j]);
            	if (files[i].type == type || (type.substring(0, 1) === '.' && type === ext)) {
        	    	acceptedFiles.push(files[i]);
        	    	break;
        	    }
            }
        }
	} else {
		acceptedFiles = files;
	}

	if (acceptedFiles.length === 0) {
	    return;
	}

	var formData = new FormData();

	for (var i = 0; i < acceptedFiles.length; ++i) {
	    formData.append('file[]', acceptedFiles[i]);
	}

	ajaxMessage = acceptedFiles.length === 1 ? '<?php echo translate('Файлът е добавен'); ?>' : '<?php echo translate('Файловете са добавени'); ?>';
    $.ajax({
   	    url: '<?php echo route_reset('admin', ['module' => 'files', 'controller' => 'storage', 'action' => 'upload-files']); ?>',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function (res) {
            if ($.trim(res) === '') {
        		window.location.reload(true);
            }
        },
        error: function (xhr) {
        }
    });
}

$('.dropzone').droppable();

$('.dropzone').on('dragover drop', function(event) {
    event.stopPropagation();
    event.preventDefault();
    if (event.type == 'drop') {
    	uploadFiles(event.originalEvent.dataTransfer.files, $(this).find('input[type="file"]').attr('accept'));
    }
});

$('#storage').on('change', '[type="file"]', function () {
	uploadFiles(this.files, $(this).attr('accept'));
	$(this).val('');
});
</script>
