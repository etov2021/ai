<?php

$label = translate('Meta routes');

$this->extend('shared::layouts/admin/default')
     ->section('title', $label)
     ;

$routes = app('router')->getRoutes();
foreach ($routes as $k => $v) {
    $routes[$k] = translate($v->getDescription());
}

$languages = [];
foreach ($this->languages as $lang) {
    $languages[$lang['code']] = $lang['name'];
}

?>
<div class="row">
	<div class="col-md-12">
		<h1 class="page-title txt-color-blueDark">
			<i class="fa fa-pencil-square-o fa-fw "></i>
			<?php echo $label; ?>
		</h1>
	</div>
</div>
<div class="row">
	<div class="col-md-6">
		<label><?php echo translate('Тип страница'); ?></label>
		<select id="route" class="form-control select2"><?php echo build_options($routes, $this->route, translate('Избери')); ?></select>
	</div>
	<div class="col-md-6">
		<label><?php echo translate('Език'); ?></label>
		<select id="language" class="form-control select2"><?php echo build_options($languages, $this->language->getCode()); ?></select>
	</div>
</div>
<div class="row" style="margin-top: 10px">
<?php if ($this->route) : ?>
	<div class="col-md-12">
    	<form class="form-horizontal" action="<?php echo route(); ?>" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="col-md-12">
                    <div class="panel panel-default">
                    	<div class="panel-heading">
                    		<strong><?php echo isset($routes[$this->route]) ? $routes[$this->route] : $this->route; ?></strong> /
                    		<strong><img src="templates/admin/images/blank.gif" class="flag flag-<?php echo $this->language->getLocale(); ?>" alt="<?php echo $this->language->getName(); ?>"> <?php echo $this->language->getName(); ?></strong>
                		</div>
                        <div class="panel-body">
                            <div class="form-group">
                            	<div class="col-md-12">
                                    <label><?php echo translate('Заглавие'); ?></label>
                                    <input class="form-control" type="text" data-update name="title" value="<?php echo $this->meta['title']; ?>" />
                                </div>
                            </div>
                            <div class="form-group" style="margin-bottom: 0">
                            	<div class="col-md-12">
                                    <label><?php echo translate('Описание'); ?></label>
                                    <textarea class="form-control" data-update name="description"><?php echo $this->meta['description']; ?></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
	</div>
<?php else: ?>
	<div class="col-md-12"><?php echo translate('Моля, изберете тип страница и домейн'); ?></div>
<?php endif; ?>
</div>
<?php $this->start('scripts'); ?>
<script>
$('#route, #language').on('change', function () {
	var route = $('#route').val();
	var language = $('#language').val();
	window.location.href = '<?php echo route_reset(null, ['module' => 'seo', 'controller' => 'meta-routes']); ?>?route=' + route + '&meta_language=' + language;
});
var timeoutId = 0;
$('[data-update]').on('input propertychange', function () {
	var that = $(this);
	var form = that.closest('form');
	clearTimeout(timeoutId);
	timeoutId = setTimeout(function() {
		ajaxMessage = '<?php echo translate('Информацията е обновена'); ?>';
		$.post('<?php echo route(null, ['action' => 'ajax-update']); ?>',  form.serializeArray(), function() {}, 'json');
		//that.blur();
	}, 500);
});
</script>
<?php $this->stop(); ?>