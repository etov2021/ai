<?php $this->start('scripts'); ?>
<script>
$(function () {
	$('input[name="auth2fa"]').on('click', function () {
		if ($(this).val() == 'google') {
			$('.googleAuth').show();
		} else {
			$('.googleAuth').hide();
		}
	});
});
</script>
<?php $this->stop(); ?>