<script>
$('.toggleTinymce').on('click', function () {
	var el = $("#" + $(this).data('content-id'));
	if (el.is(':visible')) {
		if ($.fn.tinymce) {
			el.tinymce(tinymceConfig);
		}
	} else {
		if ($.fn.tinymce) {
			el.tinymce().remove();
		}
	}
});
</script>
