<script>

$('#route').on('change', function (e, routeData, qsaData) {

	if ($.trim($(this).val()) === '') {
	    $('#routeData').html('');
	    return true;
	}

	if (typeof routeData === 'undefined') {
		routeData = '[]';
	}

	if (typeof qsaData === 'undefined') {
		qsaData = '';
	}

    $.post('<?php echo route(\null, array('action' => 'ajax-get-route-data')); ?>', {route: $(this).val(), routeData: routeData, qsaData: qsaData}, function (res) {
        $('#routeData').html(res);
    });
});

if ($('#route').val()) {
	$('#route').trigger('change', ['<?php echo ($this->item->getRouteData() ? $this->item->getRouteData() : '[]'); ?>', '<?php echo $this->item->getQsaData(); ?>']);
}

$('[name="btnSave"], [name="btnApply"]').on('click', function () {

	if ($('#routeData').children().length) {

		var errors = {};

		$('#routeData [data-element]').each(function () {

			var key = $(this).attr('data-element');
			var val = $.trim($(this).val());

			if (errors[key]) {
				delete errors[key];
			}

			if ($(this).attr('data-required') == "1") {
				if (val == '') {
					errors[key] = '<?php echo translate('Полето е задължително'); ?>';
				}
			}

			if ($(this).attr('data-condition') && val != '') {
				var re = new RegExp('^' + $(this).attr('data-condition') + '$');
				if (re.exec(val) == null) {
					errors[key] = '<?php echo translate('Невалидна стойност'); ?>';
				}
			}

			var errorElement = $('#routeData .routeData-' + key + '-element-error');

			if (errors[key]) {
				errorElement.html(errors[key]);
			} else {
				errorElement.html("");
			}

		});

		if (Object.keys(errors).length) {
			return false;
		}
	}
});
</script>
<?php $this->stop(); ?>