<script src="templates/admin/libs/jquery-nestable/jquery.nestable.min.js"></script>
<script>
var tree = $('#nestable3');
tree.nestable({
	expandBtnHTML: '',
	collapseBtnHTML: ''
});
var oldData = JSON.stringify(tree.nestable('serialize'));
tree.on('change', function() {
	var data = JSON.stringify(tree.nestable('serialize'));
	if (data === oldData) {
		return;
	}
	ajaxMessage = app.translate('Елементите са подредени');
	$.post('<?php echo route(\null, array('action' => 'ajax-set-order')); ?>', {data: data}, function () {
		oldData = data;
	}, 'json').always(function () {

	});
});
$('.copy').on('click', function () {
	try {
		$('#modal').data('copyUrl', $(this).attr('href'));
		$('#modal').modal();
	} catch (e) {
		console.log(e)
	}
	return false;
});
$('[data-handler="copy"]').on('click', function () {
	var val = $.trim($(this).closest('form').find('select').val());
	if (val !== '') {
		$('#modal .modal-body').block();
    	$.post($('#modal').data('copyUrl'), {toMenuId: val, menuId: <?php echo (int) $this->menu['id']; ?>}, function () {
			window.location.reload(true);
    	}, 'json').always(function () {
    		$('#modal .modal-body').unblock();
    	});
	}
	return false;
});
</script>
<?php $this->stop(); ?>