$statusText = ['created' => 'създадено', 'rejected' => 'отхвърлено', 'failed' => 'грешка', 'working' => 'в процес'];

// Малък блок за събитие в месечния и седмичния изглед; щракването отваря подробностите.
$chip = static function (array $s, bool $withTime = true): string {
    $classes = 'cal-chip cal-c' . (int) $s['color'] . ($s['type'] === 'proposal' ? ' cal-proposal' : '') . ($s['allDay'] ? ' cal-allday' : '') . ($s['tentative'] ? ' cal-tentative' : '');
    $time = !$s['allDay'] && $withTime && $s['first'] ? '<b>' . escape($s['segStart']->format('H:i')) . '</b> ' : '';
    $mark = $s['type'] === 'proposal' ? '<i class="mdi mdi-help-circle-outline"></i> ' : '';

    return '<a href="#" class="' . $classes . '" data-cal-key="' . escape($s['key']) . '" title="' . escape($s['title']) . '">' . $mark . $time . escape($s['title']) . '</a>';
};

