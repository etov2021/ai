				<script>
				(function () {
					var data = JSON.parse(document.getElementById('cal-data').textContent || '{}');
					var modal = document.getElementById('cal-modal');

					function show(id, text) {
						var el = document.getElementById(id);
						el.textContent = text || '';
						var row = el.closest('.cal-row');
						if (row) { row.style.display = text ? '' : 'none'; }
					}
					function link(id, url) {
						var a = document.getElementById(id);
						var ok = /^https:\/\//.test(url || '');
						a.style.display = ok ? '' : 'none';
						if (ok) { a.setAttribute('href', url); }
					}
					function open(key) {
						var d = data[key];
						if (!d) { return; }
						var proposal = d.type === 'proposal';
						document.getElementById('cal-m-title').textContent = d.title;
						document.getElementById('cal-bar').style.background = proposal ? '#f0ad00' : '#3b82f6';
						show('cal-m-when', d.when);
						show('cal-m-location', d.location);
						show('cal-m-organizer', d.organizer);
						show('cal-m-attendees', (d.attendees || []).join(', '));
						show('cal-m-description', d.description);
						modal.querySelector('[data-opt="proposal"]').style.display = proposal ? '' : 'none';
						link('cal-m-meet', d.meet);
						link('cal-m-link', d.link);
						['cal-m-approve', 'cal-m-reject'].forEach(function (id) {
							var b = document.getElementById(id);
							b.style.display = proposal ? '' : 'none';
							b.value = proposal ? String(d.proposalId) : '';
						});
						modal.classList.add('cal-open');
					}
					function close() { modal.classList.remove('cal-open'); }

					document.addEventListener('click', function (e) {
						var t = e.target.closest('[data-cal-key]');
						if (t) { e.preventDefault(); open(t.getAttribute('data-cal-key')); return; }
						if (e.target === modal || e.target.closest('[data-cal-close]')) { close(); }
					});
					document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { close(); } });

					var scroll = document.getElementById('cal-scroll');
					if (scroll) { scroll.scrollTop = 7 * 48; }
				})();
				</script>

