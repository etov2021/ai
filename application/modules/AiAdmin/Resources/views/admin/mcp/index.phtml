							<?php endif; ?>
							</tbody>
						</table>
					</div>
				<?php endforeach; ?>
				<?php if (empty($this->servers)) : ?>
					<p class="text-muted">Няма конфигурирани MCP сървъри.</p>
				<?php endif; ?>
			</div>
		</div>
	</div>
</div>
