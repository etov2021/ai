	<div class="col-12">
		<div class="card">
			<div class="card-body">
				<h2 class="mb-4"><i class="fa fa-plug fa-fw"></i> <?php echo escape($label); ?></h2>
				<p class="text-muted">
					Сървърите се задават в <code>config/ai.php</code> (<code>ai.mcp.servers</code>). Агентът получава само инструментите от <code>allowed_tools</code>.
