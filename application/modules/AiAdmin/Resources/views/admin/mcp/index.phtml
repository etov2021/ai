							</thead>
							<tbody>
							<?php foreach ($server['tools'] as $tool) : ?>
								<tr>
									<td><?php echo escape($tool['name']); ?></td>
									<td><code><?php echo escape($tool['local']); ?></code></td>
									<td><?php echo escape($tool['description']); ?></td>
									<td><?php echo $tool['allowed'] ? 'да' : 'не'; ?></td>
