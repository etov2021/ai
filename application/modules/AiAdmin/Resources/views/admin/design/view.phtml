<script>
(function () {
	var frame = document.getElementById('design-preview');
	document.querySelectorAll('[data-width]').forEach(function (button) {
		button.addEventListener('click', function () { frame.style.width = button.getAttribute('data-width'); });
	});

	document.getElementById('design-copy').addEventListener('click', function () {
		var code = document.getElementById('design-code');
		var done = function () { document.getElementById('design-copied').style.display = 'inline'; };
		if (navigator.clipboard && window.isSecureContext) {
			navigator.clipboard.writeText(code.value).then(done);
		} else {
			code.select();
			if (document.execCommand('copy')) { done(); }
		}
	});
})();
</script>
