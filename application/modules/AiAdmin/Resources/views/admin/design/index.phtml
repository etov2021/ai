$select = static function (string $name, array $options, string $selected = '', string $id = ''): string {
    $html = '<select class="form-control" name="' . escape($name) . '" id="' . escape($id ?: $name) . '">';
    foreach ($options as $value => $text) {
        $html .= '<option value="' . escape((string) $value) . '"' . ((string) $value === $selected ? ' selected="selected"' : '') . '>' . escape($text) . '</option>';
    }

    return $html . '</select>';
};

