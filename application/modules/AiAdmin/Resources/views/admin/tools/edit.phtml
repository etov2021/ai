<script>
(function () {
	var form = document.querySelector('form.form-horizontal');
	if (!form) { return; }
	var type = form.querySelector('[name="type"]');
	var picker = document.getElementById('builtin-picker');
	var select = document.getElementById('builtin-select');
	var httpFields = document.getElementById('http-fields');
	var code = form.querySelector('[name="code"]');
	var name = form.querySelector('[name="name"]');
	var description = form.querySelector('[name="description"]');
	if (!type) { return; }

	// За вграден инструмент параметрите идват от кода, затова полетата за HTTP се скриват.
	function sync() {
		var builtin = type.value === 'builtin';
		if (picker) { picker.style.display = builtin ? '' : 'none'; }
		if (httpFields) { httpFields.style.display = builtin ? 'none' : ''; }
	}
	type.addEventListener('change', sync);
	sync();

	if (select) {
		select.addEventListener('change', function () {
			var option = select.options[select.selectedIndex];
			if (!option || !option.value) { return; }
			if (code) { code.value = option.value; }
			if (name && name.value === '') { name.value = option.value; }
			if (description && description.value === '') { description.value = option.getAttribute('data-description') || ''; }
		});
	}
})();
</script>
