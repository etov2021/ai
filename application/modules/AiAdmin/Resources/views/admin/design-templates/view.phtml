     ->section('title', $label);

$template = $this->template;

?>
<div class="row">
	<div class="col-12">
		<div class="card">
			<div class="card-body">
				<h2 class="mb-3"><i class="fa fa-th-large fa-fw"></i> <?php echo escape($label); ?></h2>
