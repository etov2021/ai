						<a class="btn btn-default" href="<?php echo escape($this->homeUrl); ?>">Към списъка</a>
						<button type="submit" class="btn btn-danger" onclick="return confirm('Шаблонът и файловете му ще бъдат изтрити. Да продължа ли?');">Изтрий</button>
