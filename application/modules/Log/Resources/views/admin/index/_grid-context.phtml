    /* $data = [
        'before' => ['ENTITY' => $data['ENTITY'], 'EVENT' => $data['EVENT']] + $originalData,
        'after' => $data,
    ]; */
}

if (!function_exists('doOutputList')) {
    function doOutputList($tree) {
        $buff = '<ul style="margin: 0; padding: 0 0 0 15px;">';
        foreach($tree as $k => $v) {
            $buff .= '<li>';
            $buff .= "<strong>" . $k . "</strong>: ";
            if (is_array($v)) {
                $buff .= doOutputList($v);
            } else {
                if (is_null($v)) {
                    $buff .= 'NULL';
                } else if (is_scalar($v)) {
                    $buff .= strip_tags($v);
                } else {
                    $buff .= json_encode($v);
                }
            }
            $buff .= '</li>';
        }
        $buff .= '</ul>';
        return $buff;
    }
}

