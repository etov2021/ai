<script>
$('.removeSetting').on('click', function () {
	var that = $(this);
	smart.confirm("<?php echo escaper('js', translate("Сигурни ли сте, че искате да изтриете записа?")); ?>", function (yes) {
		if (yes) {
			ajaxMessage = '<?php echo translate('Настройката е изтрита'); ?>';
			$.post(that.attr('href'), {}, function () {
				var section = that.closest('.section');
				that.closest('tr').remove();
				if (!section.find('tbody tr').length) {
					$('#tab-' + section.attr('data-id')).remove();
					section.remove();
					$('.tabs').tabs('option', 'active', 0);
				}
			});
		}
	});
	return false;
});
</script>
<?php $this->stop(); ?>